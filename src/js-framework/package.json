{
  "name": "betterncm-community-framework",
  "version": "1.0.0",
  "description": "Frontend framework for the BetterNCM Community maintained edition",
  "main": "index.js",
  "scripts": {
    "build:dev": "esbuild ./src/index.ts --bundle --sourcemap=inline --target=chrome91 --outfile=../framework.js",
    "build": "esbuild ./src/index.ts --minify --bundle --sourcemap --target=chrome91 --outfile=../framework.js",
    "gentypes": "tsc --outfile index.d.ts --module none && rome format --write ./index.d.ts",
    "fmt": "rome format --write ./src ./index.d.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "BetterNCM Community maintainers",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "esbuild": "^0.16.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "rome": "^11.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
