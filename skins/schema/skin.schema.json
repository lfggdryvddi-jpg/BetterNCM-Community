{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BetterNCM Community Skin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "author", "description", "entry", "license", "compatibility", "tags"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 240 },
    "entry": {
      "type": "string",
      "pattern": "^[^/\\\\][^:]*\\.css$"
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["betterncm", "ncm"],
      "properties": {
        "betterncm": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ncm": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" },
      "uniqueItems": true
    },
    "preview": { "type": "string", "pattern": "^[^/\\\\][^:]*$" }
  }
}
